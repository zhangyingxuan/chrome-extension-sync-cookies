{
  "manifest_version": 3,
  "name": "跨域同步cookies",
  "version": "1.1.0",
  "description": "用于在不同域名之间自动同步/手动同步 cookies，特别适合开发和测试环境使用。",
  "icons": {
    "16": "sources/cookie16.png",
    "32": "sources/cookie32.png",
    "48": "sources/cookie48.png",
    "128": "sources/cookie128.png"
  },
  "action": {
    "default_icon": "sources/cookie48.png",
    "default_title": "用于在不同域名之间自动/手动同步 cookies，特别适合开发和测试环境使用。",
    "default_popup": "index.html"
  },
  "permissions": ["storage", "cookies"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
